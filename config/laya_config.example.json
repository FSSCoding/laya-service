{
  "model_dir": "CHANGE_ME: absolute path to a directory containing laya.onnx, laya.onnx.data, laya_config.json and tokenizer/",
  "host": "127.0.0.1",
  "port": 11448,
  "gpu": {
    "visible_devices": "0",
    "providers": [
      { "name": "CUDAExecutionProvider", "options": {} },
      { "name": "CPUExecutionProvider", "options": {} }
    ]
  },
  "idle": {
    "unload_after_s": 300,
    "enabled": true
  },
  "cache": {
    "enabled": true,
    "ttl_days": 30,
    "max_memory_entries": 10000,
    "db_path": "~/.laya-service/result_cache.db"
  },
  "batcher": {
    "max_batch_size": 512,
    "max_wait_ms": 5
  }
}
